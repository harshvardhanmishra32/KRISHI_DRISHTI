# -----------------------------------------------------------------------------
# Krishi Drishti - Environment Variables Example
# Duplicate this file as .env and replace placeholder values for production.
# -----------------------------------------------------------------------------

# Application
PROJECT_NAME="Krishi Drishti API"
ENVIRONMENT=development
DEBUG=True
SECRET_KEY=
# Generate a private key with: python -c "import secrets; print(secrets.token_urlsafe(48))"
CORS_ORIGINS=["http://localhost:3000"]

# External APIs
OPENWEATHER_API_KEY=your_openweather_api_key_here

# PostgreSQL + PostGIS Configuration
POSTGRES_USER=krishi_user
POSTGRES_PASSWORD=krishi_secure_password_123
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=krishi_db
DATABASE_URL=postgresql://krishi_user:krishi_secure_password_123@localhost:5432/krishi_db

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/0

# Storage & Upload Configuration (P06)
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=5
STORAGE_BACKEND=local
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
